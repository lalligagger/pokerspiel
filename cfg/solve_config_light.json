{
  "mode": "hulh",
  "solver": "external",
  "preset": "hulh-preflop",
  "iterations": 1000000,
  "checkpoint_every": 10000,
  "stability_threshold": 0.9,
  "stop_threshold": 0.85,
  "memory_threshold": 0.85,
  "sampling_policy": {
    "preflop": "exact_only",
    "postflop": "diagnostic_only"
  },
  "stop_patience": 3,
  "min_iterations": 10000,
  "range_samples": 25,
  "range_last_n": 1000,
  "report_mode": "summary",
  "artifact_mode": "lightweight",
  "checkpoint_history_limit": 2,
  "output_json": "./app/data/solve_light/report.json"
}