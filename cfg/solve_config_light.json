{
  "name": "lightweight-local-or-gce",
  "deploy": "gce",
  "project": "pokerspiel",
  "zone": "us-west1-b",
  "mode": "hulh",
  "solver": "outcome",
  "preset": "hulh-preflop",
  "iterations": 5000,
  "stability_checkpoint": 1000,
  "stability_threshold": 0.02,
  "stop_patience": 2,
  "min_iterations": 0,
  "range_samples": 250,
  "postflop_samples": 32,
  "range_last_n": 200,
  "report_mode": "summary",
  "artifact_mode": "lightweight",
  "checkpoint_history_limit": 0,
  "output_json": "./app/data/solve_light/report.json",
  "solver_env": {
    "POKERSPIEL_SOLVER": "outcome",
    "POKERSPIEL_PRESET": "hulh-preflop",
    "POKERSPIEL_RANGE_SAMPLES": 250,
    "POKERSPIEL_POSTFLOP_SAMPLES": 32,
    "POKERSPIEL_STABILITY_THRESHOLD": 0.02,
    "POKERSPIEL_STOP_PATIENCE": 2,
    "POKERSPIEL_MIN_ITERATIONS": 0,
    "POKERSPIEL_OUTPUT_JSON": "./app/data/solve_light/report.json"
  },
  "notes": [
    "Fast smoke test",
    "Zero checkpointing",
    "Range export only",
    "No full snapshot artifacts",
    "Good multi-instance validation profile",
    "Values under solver_env are materialized as generated environment variables at launch time"
  ]
}
