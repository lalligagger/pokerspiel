{
  "mode": "hulh",
  "solver": "external",
  "preset": "hulh-preflop",
  "iterations": 250000,
  "checkpoint_every": 5000,
  "stability_threshold": 0.5,
  "memory_threshold": 0.85,
  "sampling_policy": {
    "preflop": "exact_only",
    "postflop": "diagnostic_only"
  },
  "stop_patience": 1,
  "min_iterations": 1000,
  "report_mode": "summary",
  "artifact_mode": "lightweight",
  "checkpoint_history_limit": 2,
  "output_json": "./app/data/solve_light/report.json"
}