{
  "name": "heavy-local-or-gce",
  "deploy": "local",
  "mode": "hulh",
  "solver": "outcome",
  "preset": "hulh-preflop",
  "iterations": 10000,
  "checkpoint_every": 1000,
  "min_iterations": 1000,
  "range_samples": 1326,
